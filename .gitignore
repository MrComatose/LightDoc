# Node.js dependencies
/node_modules/

# Optional npm package lock file
/package-lock.json

# Yarn dependencies (if you're using Yarn)
/yarn.lock

# Output of the TypeScript compiler
/dist/
*/dist/
/build/

# Optional IDE/Editor settings
/.idea/
/.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variable files
.env
.env.* # Exclude all .env files, including .env.local, .env.development, etc.

# Optional: For coverage reports (if you're using Jest or any testing framework)
/coverage/

# Optional: Exclude package dependency files for security (e.g. .env or .npmrc)
.npmrc
*.pem
*.cer
*.dat